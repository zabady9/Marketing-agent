# =============================================================================
# Application
# =============================================================================
APP_ENV=development
# WARNING: Setting DEBUG=true enables /api/docs (Swagger UI) — never enable in production.
DEBUG=false
# Required: protects all /api/admin/* endpoints. Generate with: openssl rand -hex 32
ADMIN_API_KEY=generate-a-strong-random-secret-here
# Comma-separated allowed CORS origins (default covers local dev)
# ALLOWED_ORIGINS=["*"]

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/analyst
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=analyst

# =============================================================================
# Gemini / LangChain
# =============================================================================
GOOGLE_API_KEY=your-google-api-key-here
REASONING_MODEL=gemini-2.5-pro
CHEAP_MODEL=gemini-2.5-flash
MAX_TOKENS=8192

# =============================================================================
# LangSmith (optional tracing — set LANGSMITH_TRACING=true to enable)
# =============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT=analyst-agent

# =============================================================================
# Tavily web search (required for web_search tool and market data lookups;
# get a key at https://tavily.com)
# =============================================================================
TAVILY_API_KEY=your-tavily-api-key-here

# =============================================================================
# Nginx / SSL (production only)
# =============================================================================
DOMAIN=analyst.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
